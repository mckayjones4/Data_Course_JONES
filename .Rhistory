names(male) <- names(male) %>% str_remove('m_')
names(female) <- names(female) %>% str_remove('f_')
names(unsexed) <- names(unsexed) %>% str_remove('unsexed_')
real_clean_data = male %>%
full_join(female) %>%
full_join(unsexed)
