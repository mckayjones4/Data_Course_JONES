'Clutch_size', 'Egg_mass') %>%
str_to_lower()
# separate male data
male = dat %>%
clean_names() %>%
select(keepers, starts_with('m_'), -ends_with('_n')) %>%
mutate(sex = 'male')
# separate female data
female = dat %>%
clean_names() %>%
select(keepers, starts_with('f_'), -ends_with('_n')) %>%
mutate(sex = 'female')
# separate unsexed data
unsexed = dat %>%
